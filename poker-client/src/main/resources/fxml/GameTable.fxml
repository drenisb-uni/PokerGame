<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="639.0" prefWidth="1366.0" styleClass="root-pane" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokergame.client.view.controllers.table.GameController">

    <children>
        <BorderPane>

            <top>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 30 0 0 0;">
               <Label fx:id="inviteCodeLabel" layoutX="639.0" layoutY="40.0" text="room code: ">
                  <styleClass>
                     <String fx:value="status-text" />
                     <String fx:value="subtitle-text" />
                  </styleClass>
               </Label>
                    <Label fx:id="gameStatusLabel" styleClass="status-text" text="Waiting for players..." />

                    <HBox alignment="CENTER" spacing="15.0">
                        <ImageView fx:id="commCard1" fitHeight="140.0" fitWidth="100.0" preserveRatio="true" styleClass="card-image" />
                        <ImageView fx:id="commCard2" fitHeight="140.0" fitWidth="100.0" preserveRatio="true" styleClass="card-image" />
                        <ImageView fx:id="commCard3" fitHeight="140.0" fitWidth="100.0" preserveRatio="true" styleClass="card-image" />
                        <ImageView fx:id="commCard4" fitHeight="140.0" fitWidth="100.0" preserveRatio="true" styleClass="card-image" />
                        <ImageView fx:id="commCard5" fitHeight="140.0" fitWidth="100.0" preserveRatio="true" styleClass="card-image" />
                    </HBox>
                </VBox>
            </top>

            <center>
                <FlowPane fx:id="playersContainer" alignment="CENTER" hgap="40.0" vgap="40.0" />
            </center>

            <bottom>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 0 0 40 0;">
                    <Label fx:id="chipsInfoLabel" styleClass="chips-text" text="Your Chips: $1000  |  Pot: $0" />

                    <HBox alignment="CENTER" spacing="20.0">
                        <Button fx:id="foldButton" onAction="#handleFold" styleClass="action-btn, fold-btn" text="Fold" />
                        <Button fx:id="callButton" onAction="#handleCall" styleClass="action-btn, call-btn" text="Call" />
                        <Button fx:id="raiseButton" onAction="#handleRaisePopup" styleClass="action-btn, raise-btn" text="Raise" />
                    </HBox>

                    <ListView fx:id="actionFeedList" maxHeight="110.0" maxWidth="420.0" styleClass="action-feed" />

                    <HBox alignment="CENTER" spacing="15.0">
                        <Button fx:id="addBotButton" lineSpacing="2.0" onAction="#handleAddBot" prefWidth="120.0" styleClass="table-tool-btn" text="Add Bot" />
                  <Button fx:id="startButton" layoutX="570.0" layoutY="10.0" lineSpacing="2.0" onAction="#handleStartHand" prefWidth="120.0" styleClass="table-tool-btn" text="START" />
                        <Button fx:id="leaveButton" lineSpacing="2.0" onAction="#handleLeaveTable" styleClass="table-tool-btn, leave-table-btn" text="Leave Table" />
                    </HBox>
                </VBox>
            </bottom>

        </BorderPane>

        <StackPane fx:id="raisePopupOverlay" style="-fx-background-color: rgba(0, 0, 0, 0.7);" visible="false">

            <VBox alignment="CENTER" maxHeight="200.0" maxWidth="350.0" spacing="20.0" styleClass="popup-box">

                <Label styleClass="popup-title" text="Raise Amount" />

                <TextField fx:id="raiseAmountField" promptText="Enter amount..." styleClass="input-field" />

                <HBox alignment="CENTER" spacing="15.0">
                    <Button onAction="#handleAllIn" styleClass="popup-btn, all-in-btn" text="All In!" />
                    <Button onAction="#handleRaise" styleClass="popup-btn, confirm-btn" text="Confirm" />
                    <Button onAction="#handleRaisePopup" styleClass="popup-btn, cancel-btn" text="Cancel" />
                </HBox>

            </VBox>

        </StackPane>

    </children>
</StackPane>
