<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="639.0" prefWidth="1366.0" styleClass="root-pane" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokergame.client.view.controllers.LobbyController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 20 40 20 40;">
            <Label styleClass="title-text" text="Texas Hold'em Lobby" />

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="bankrollLabel" styleClass="bankroll-text" text="Bankroll: $0" />
            <Button onAction="#handleProfile" styleClass="secondary-button" text="Profile" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15.0">
            <Button onAction="#handlePlayNow" styleClass="primary-button, massive-btn" text="Play Bots" />
            <Label style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;" text="Start playing right away" />
         <Button layoutX="582.0" layoutY="60.0" onAction="#handleHostTable" text="Host Table">
            <styleClass>
               <String fx:value="massive-btn" />
               <String fx:value="all-in-btn" />
               <String fx:value="primary-button" />
            </styleClass>
         </Button>
         <Label layoutX="620.0" layoutY="117.0" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;" text="Get your friends to join" />
        </VBox>
    </center>

    <bottom>
        <VBox spacing="20.0" style="-fx-padding: 0 40 40 40;">
            <Label styleClass="subtitle-text" text="Available Tables" />

            <HBox alignment="CENTER_LEFT" spacing="25.0">

                <VBox spacing="12.0" styleClass="table-card">
                    <Label styleClass="card-title" text="Host: Daniel Negreanu" />
                    <Label styleClass="card-detail" text="Buy-in: $500" />
                    <Button fx:id="danielTableButton" maxWidth="1.7976931348623157E308" onAction="#handleJoinDanielTable" styleClass="primary-button" text="Join Table" />
                </VBox>

                <VBox spacing="12.0" styleClass="table-card">
                    <Label styleClass="card-title" text="Host: Phil Ivey" />
                    <Label styleClass="card-detail" text="Buy-in: $10,000" />
                    <Button fx:id="philTableButton" maxWidth="1.7976931348623157E308" onAction="#handleJoinPhilTable" styleClass="primary-button" text="Join Table" />
                </VBox>

                <VBox spacing="12.0" styleClass="table-card">
                    <Label styleClass="card-title" text="Host: Local Game" />
                    <Label styleClass="card-detail" text="Buy-in: $50" />
                    <Button fx:id="localTableButton" maxWidth="1.7976931348623157E308" onAction="#handleJoinLocalTable" styleClass="primary-button" text="Join Table" />
                </VBox>

            </HBox>
        </VBox>
    </bottom>

</BorderPane>
