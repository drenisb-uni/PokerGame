<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="root-pane" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokergame.client.view.controllers.ConfigurationController">

    <HBox alignment="CENTER" layoutX="0.0" layoutY="30.0" prefWidth="800.0">
        <Label styleClass="title-text" text="Multiplayer Setup" />
    </HBox>
   <HBox layoutX="100.0" layoutY="128.0" prefWidth="700.0">
      <children>
      
          <VBox alignment="CENTER" prefWidth="400.0" spacing="25.0" styleClass="table-card">
      
              <VBox alignment="CENTER" spacing="8.0">
                  <Label styleClass="card-title" text="Table Name" />
                  <Label styleClass="card-detail" text="What should we call your room?" />
                  <TextField fx:id="tableNameInput" maxWidth="250.0" prefWidth="250.0" promptText="e.g., High Rollers Club" styleClass="input-field" />
              </VBox>
      
              <VBox alignment="CENTER" spacing="8.0">
                  <Label styleClass="card-title" text="Buy-In Amount" />
                  <Label styleClass="card-detail" text="Starting chips for the table" />
                  <TextField fx:id="buyInInput" maxWidth="250.0" prefWidth="250.0" promptText="e.g., 5000" styleClass="input-field" />
              </VBox>
      
              <VBox alignment="CENTER" spacing="8.0">
                  <Label styleClass="card-title" text="Add Bots" />
                  <Label styleClass="card-detail" text="Fill empty seats with AI?" />
                  <ComboBox fx:id="addBotsComboBox" maxWidth="250.0" prefWidth="250.0" styleClass="input-field">
                      <items>
                          <FXCollections fx:factory="observableArrayList">
                              <String fx:value="0 Bots (Players Only)" />
                              <String fx:value="1 Bot" />
                              <String fx:value="2 Bots" />
                              <String fx:value="3 Bots" />
                              <String fx:value="4 Bots" />
                          </FXCollections>
                      </items>
                      <value>
                          <String fx:value="0 Bots (Players Only)" />
                      </value>
                  </ComboBox>
              </VBox>
      
          </VBox>
      
          <HBox alignment="CENTER" prefHeight="202.0" prefWidth="377.0">
              <Button graphicTextGap="0.0" mnemonicParsing="false" onAction="#handleStartMultiplayer" prefHeight="71.0" prefWidth="279.0" text="Start Table" textAlignment="CENTER">
               <styleClass>
                  <String fx:value="primary-button" />
                  <String fx:value="massive-btn" />
               </styleClass>
              </Button>
          </HBox>
      </children>
   </HBox>

</AnchorPane>
